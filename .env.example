# Q-Alpha — secrets template. Copy to `.env` (gitignored) and fill in.
# Kite Connect (Zerodha) app credentials — https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# Minted daily by `python -m qalpha.live.auth`; Kite access tokens expire ~6am IST next day.
KITE_ACCESS_TOKEN=
# Dashboard gate — required when the dashboard is hosted (public URL). Empty = open (local dev only).
APP_PASSWORD=

# --- Reading filings on this machine -----------------------------------------------------------
# Set QALPHA_LOCAL_MODEL and filings are read here, by these weights, and no document leaves the
# machine. There is deliberately NO default: which model read a filing is part of what the
# extraction row records, so it must be stated rather than guessed.
#
#   ollama pull qwen3:8b
#   ollama create qwen3-8b-32k -f docs/ollama/Modelfile.qwen3-8b-32k
#   →   QALPHA_LOCAL_MODEL=qwen3-8b-32k
#
# The name must be a tag the server actually lists (`ollama list`). A near-miss used to pass the
# check and then 404 on every call, while the page said that model was reading the filings.
#
# If this is set and the server is unreachable, the run does NOT fall back to the cloud — it
# archives the filings and says they were not read. Falling back would send documents over the
# network on the one evening you believed nothing was.
QALPHA_LOCAL_MODEL=
# Where the local server listens. Default is Ollama's; llama.cpp's llama-server is :8080.
# NOT Open WebUI (:8080 or :3000) — that is a chat front end, and it answers /v1/models with a web
# page. Point this at whatever actually runs the weights.
QALPHA_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# Context window of the loaded model, in tokens. Below ~8192 the run refuses rather than let the
# server silently truncate a filing while coverage counts it as read. This states what the model was
# BUILT with (see the Modelfile above); it cannot change it, because the OpenAI-compatible route has
# nowhere to send num_ctx.
QALPHA_LOCAL_MODEL_CONTEXT=32768
# Seconds one call may take before the run gives up on it. The default (300) is deliberately well
# under the evidence run's own budget, so one wedged call cannot spend the whole evening.
QALPHA_LOCAL_MODEL_TIMEOUT=
