# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Data (large; regenerated by ingest) — keep the dirs via .gitkeep, ignore contents
data/historical/*
data/fundamentals/*
data/universes/*
# point-in-time membership = small reference data; track it (the pipeline/CI needs it)
!data/universes/*.csv
data/bhavcopy/*
!data/**/.gitkeep
!data/**/README.md
# data/paper/ (the notional paper book + track record) is TRACKED on purpose — no secrets, and the
# daily pipeline commits it as the durable record.
# Personal discretionary IPO/satellite positions — account-specific, keep out of the public repo.
data/satellite.json

# Broker exports — contain PAN / client-id / name PII; never commit (resume repo is public).
# The crit-4 reconciliation reads these locally; tests use a hermetic synthetic fixture instead.
data/tradebook-*.csv
# The local run's drop folder. The old rule matched `data/tradebook-*.csv` and NOT this directory,
# so a broad `git add -A` would have published a real Console export — name, holdings, every trade —
# into a PUBLIC repository. Found in review 2026-09-09; no export had been committed.
data/tradebooks/
data/taxpnl-*
data/*.jpeg
data/*.jpg
# Generated reconciliation report echoes the real client-id — keep it local (it's regenerable).
reports/crit4_reconciliation.md

# Reports
reports/*.html
reports/*.png

# Secrets — never commit broker creds (Kite api_key/secret) or minted sessions
.env
*.env
!.env.example
secrets/
.kite_session.json
# .streamlit/config.toml IS tracked (it is the theme). Streamlit's secrets file is not, and it sits
# in the same directory — an easy way to commit the Kite credentials by accident.
.streamlit/secrets.toml

# The local run's output page — regenerated every run, 17KB, never a source of truth.
# The records beside it (snapshot.json, snapshots/, ledger.jsonl, commitments.jsonl) ARE tracked:
# they are what makes a decision replayable, and a decision citing a snapshot nobody kept is a
# citation pointing at nothing.
# --- This machine's own record ----------------------------------------------------------------
# The local run's state belongs to the machine that produced it, not to the repository. The ledger
# says which steps THIS desktop has finished; the snapshots are the inputs THIS desktop decided on.
# Committing them would let a checkout inherit another machine's "already done" and skip work it
# has never performed — which is the resume mechanism doing precisely the wrong thing.
data/session/*.html
data/session/ledger.jsonl
data/session/snapshot.json
data/session/snapshots/

# Notebooks scratch
.ipynb_checkpoints/
pytest.log

# Evidence corpus: raw primary documents and full index responses are re-fetchable from
# nsearchives.nseindia.com by the URL in their provenance sidecar, and the sidecar's SHA-256 is what
# proves which bytes were read. Tracking the bytes themselves would add ~90MB on the first run and
# grow daily. The sidecars ARE tracked — they are the audit trail.
data/evidence/announcements/**/*.pdf
# ...but the extracted TEXT is tracked: it is what survives if NSE withdraws a document.
!data/evidence/announcements/**/*.txt.gz
data/evidence/announcements/**/index/*.json
data/evidence/reg_ind/*.csv
# ...except the documents the test-suite reads back, which must ship with the repo:
!data/evidence/reg_ind/REG1_IND270826.csv
!data/evidence/reg_ind/REG1_IND040926.csv
!data/evidence/announcements/VBL/1067*.pdf
!data/evidence/**/*.provenance.json
